---
import Layout from '../layouts/Layout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import { SITE } from '../site';
---

<Layout title={`Page Not Found | ${SITE.shortName}`} description="The page you were looking for could not be found.">
  <Section class="flex min-h-[70vh] items-center bg-navy-deep pt-40 pb-24 text-pearl md:pt-48">
    <div class="max-w-2xl">
      <p class="eyebrow text-gold-light">404 — Not Found</p>
      <h1 class="mt-8 font-serif text-[clamp(2.5rem,5.5vw,4.25rem)] font-light leading-[1.05] tracking-[-0.015em]">
        This page has quietly<br />gone missing.
      </h1>
      <p class="mt-8 max-w-md text-[0.9375rem] leading-relaxed text-pearl/65">
        The address may have changed, or the page no longer exists. Everything worth seeing is still a step away.
      </p>
      <div class="mt-12 flex flex-wrap gap-4">
        <Button href="/" variant="gold">Return Home</Button>
        <Button href="/#services" variant="outline-light">View Services</Button>
      </div>
    </div>
  </Section>
</Layout>
