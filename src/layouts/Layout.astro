---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE, AREA_SERVED } from '../site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import heroImage from '../assets/hero.png';

interface Props {
  title?: string;
  description?: string;
  /** Social-share image; defaults to the hero. */
  ogImage?: ImageMetadata;
  /** Extra JSON-LD blocks (Service, BreadcrumbList, …) appended after the sitewide LocalBusiness. */
  schema?: Record<string, unknown>[];
}

const { title = SITE.title, description = SITE.description, ogImage = heroImage, schema = [] } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: ogImage, width: 1200, format: 'jpeg' });
const ogUrl = new URL(og.src, Astro.site);

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': new URL('/#business', Astro.site).href,
  name: SITE.name,
  alternateName: SITE.shortName,
  slogan: SITE.tagline,
  description: SITE.description,
  url: Astro.site?.href,
  telephone: SITE.phone,
  email: SITE.email,
  image: ogUrl.href,
  logo: new URL('/assets/icons/logo.png', Astro.site).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address[0],
    addressLocality: 'Plainfield',
    addressRegion: 'NH',
    postalCode: '03781',
    addressCountry: 'US',
  },
  areaServed: [...AREA_SERVED, { '@type': 'Place', name: 'Upper Valley, New Hampshire & Vermont' }],
};

const schemaBlocks = [localBusiness, ...schema];
---

<!doctype html>
<html lang="en" class="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#031636" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    {schemaBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
    <script is:inline>
      // Gate all scroll animations on the visitor's motion preference.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion-ok');
      }
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="eyebrow fixed top-4 left-4 z-[60] -translate-y-24 rounded-[6px] bg-navy-deep px-5 py-3 text-pearl transition-transform duration-300 focus:translate-y-0"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
