---
/** The one button language on the site: sentence case, 6px radius, a corner
 *  arrow that lifts on hover. Deliberately not uppercase — it plays against
 *  the tracked uppercase micro-labels rather than repeating them. */
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'light' | 'dark' | 'outline-light' | 'outline-dark';
  size?: 'md' | 'sm';
  class?: string;
}

const { href, type = 'button', variant = 'dark', size = 'md', class: className = '' } = Astro.props;

const base =
  'group inline-flex items-center justify-center gap-2.5 rounded-[6px] font-sans transition-colors duration-300';

const sizes: Record<NonNullable<Props['size']>, string> = {
  md: 'px-6 py-3 text-[0.875rem]',
  sm: 'px-5 py-2.5 text-[0.8125rem]',
};

const variants: Record<NonNullable<Props['variant']>, string> = {
  dark: 'bg-navy-deep text-pearl hover:bg-ink',
  light: 'bg-pearl text-navy-deep hover:bg-white',
  'outline-light': 'border border-pearl/45 text-pearl hover:border-pearl hover:bg-pearl hover:text-navy-deep',
  'outline-dark': 'border border-ink/25 text-ink hover:border-ink hover:bg-ink hover:text-pearl',
};

const cls = [base, sizes[size], variants[variant], className].filter(Boolean).join(' ');
---

{
  href ? (
    <a href={href} class={cls}>
      <slot />
      <span
        aria-hidden="true"
        class="text-[0.8125rem] transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
      >
        ↗
      </span>
    </a>
  ) : (
    <button type={type} class={cls}>
      <slot />
      <span
        aria-hidden="true"
        class="text-[0.8125rem] transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
      >
        ↗
      </span>
    </button>
  )
}
