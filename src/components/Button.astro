---
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'light' | 'dark' | 'gold' | 'outline-light' | 'outline-dark';
  size?: 'md' | 'sm';
  class?: string;
}

const { href, type = 'button', variant = 'dark', size = 'md', class: className = '' } = Astro.props;

const base =
  'group inline-flex items-center justify-center gap-3 font-sans font-medium uppercase transition-colors duration-500';

const sizes: Record<NonNullable<Props['size']>, string> = {
  md: 'px-8 py-4 text-[0.8125rem] tracking-[0.2em]',
  sm: 'px-5 py-2.5 text-[0.6875rem] tracking-[0.22em]',
};

const variants: Record<NonNullable<Props['variant']>, string> = {
  dark: 'bg-navy text-pearl hover:bg-navy-deep',
  light: 'bg-pearl text-ink hover:bg-gold-light hover:text-navy-deep',
  gold: 'bg-gold text-navy-deep hover:bg-gold-light',
  'outline-light': 'border border-pearl/40 text-pearl hover:border-gold-light hover:text-gold-light',
  'outline-dark': 'border border-ink/30 text-ink hover:border-gold-dark hover:text-gold-dark',
};

const cls = [base, sizes[size], variants[variant], className].filter(Boolean).join(' ');
---

{
  href ? (
    <a href={href} class={cls}>
      <slot />
      <span aria-hidden="true" class="inline-block transition-transform duration-500 group-hover:translate-x-1.5">→</span>
    </a>
  ) : (
    <button type={type} class={cls}>
      <slot />
      <span aria-hidden="true" class="inline-block transition-transform duration-500 group-hover:translate-x-1.5">→</span>
    </button>
  )
}
