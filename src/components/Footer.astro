---
import { Image } from 'astro:assets';
import { SITE, NAV_LINKS, SERVICE_AREAS } from '../site';
import { SERVICES } from '../data/services';
import logo from '../assets/logo.png';

const year = new Date().getFullYear();
---

<footer class="border-t border-pearl/15 bg-navy-deep text-pearl">
  <div class="mx-auto w-full max-w-[90rem] px-6 py-16 md:px-10 lg:px-16 lg:py-20">
    <div class="grid grid-cols-12 gap-x-6 gap-y-12">
      <div class="col-span-12 lg:col-span-4">
        <div class="inline-block bg-pearl px-5 py-4">
          <Image src={logo} alt={SITE.name} width={480} densities={[1, 2]} class="h-12 w-auto" />
        </div>
        <p class="mt-6 font-serif text-2xl font-light tracking-[-0.01em]">{SITE.wordmark}</p>
        <p class="eyebrow mt-2 text-pearl/50">{SITE.wordmarkSub}</p>
        <p class="mt-8 max-w-sm text-[0.9375rem] leading-relaxed text-pearl/60">
          My mission is to protect, elevate, and thoughtfully manage the homes and estates entrusted to me.
        </p>
      </div>

      <div class="col-span-6 lg:col-span-3 lg:col-start-6">
        <p class="eyebrow mb-6 text-gold-light">Services</p>
        <ul class="space-y-3">
          {
            SERVICES.map((s) => (
              <li>
                <a
                  href={`/services/${s.slug}/`}
                  class="text-[0.8125rem] tracking-[0.18em] uppercase text-pearl/70 transition-colors duration-300 hover:text-gold-light"
                >
                  {s.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="col-span-6 lg:col-span-2 lg:col-start-9">
        <p class="eyebrow mb-6 text-gold-light">Navigate</p>
        <ul class="space-y-3">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[0.8125rem] tracking-[0.18em] uppercase text-pearl/70 transition-colors duration-300 hover:text-gold-light"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="col-span-6 lg:col-span-2 lg:col-start-11">
        <p class="eyebrow mb-6 text-gold-light">Correspondence</p>
        <a
          href={`mailto:${SITE.email}`}
          class="font-serif text-lg italic break-all text-pearl underline-offset-4 transition-colors duration-300 hover:text-gold-light hover:underline"
        >
          {SITE.email}
        </a>
        <p class="mt-4 text-[0.8125rem] leading-relaxed text-pearl/50">
          <a href={SITE.phoneHref} class="transition-colors duration-300 hover:text-gold-light">{SITE.phone}</a>
          <br />
          {SITE.address[0]}
          <br />
          {SITE.address[1]}
        </p>
      </div>
    </div>

    <div class="mt-16 border-t border-pearl/15 pt-8">
      <p class="eyebrow text-gold-light">Serving the Upper Valley</p>
      <p class="mt-3 max-w-4xl text-xs leading-relaxed text-pearl/50">
        {SERVICE_AREAS.map((region) => region.towns.map((town) => `${town}, ${region.abbr}`).join(' · ')).join(' · ')}
      </p>
    </div>

    <div
      class="mt-10 flex flex-col gap-4 border-t border-pearl/15 pt-8 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="text-xs tracking-[0.08em] text-pearl/45">© {year} {SITE.name}. All rights reserved.</p>
      <p class="font-serif text-sm italic text-pearl/45">Beauty, function, and value in quiet harmony.</p>
    </div>
  </div>
</footer>
