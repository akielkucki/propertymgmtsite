---
import { SITE, NAV_LINKS } from '../site';
---

<header
  id="site-header"
  data-scrolled="false"
  data-menu-open="false"
  class="group fixed inset-x-0 top-0 z-50 text-pearl transition-colors duration-500 data-[scrolled=true]:bg-porcelain/95 data-[scrolled=true]:text-ink data-[scrolled=true]:backdrop-blur-md data-[scrolled=true]:shadow-[0_1px_0_0_rgba(35,34,29,0.12)] data-[menu-open=true]:!bg-transparent data-[menu-open=true]:!text-pearl data-[menu-open=true]:!shadow-none"
>
  <div class="mx-auto flex h-20 w-full max-w-[90rem] items-center justify-between px-6 md:px-10 lg:h-24 lg:px-16">
    <a href="/" class="flex items-baseline gap-3" aria-label={`${SITE.name}, home`}>
      <span class="font-serif text-[1.375rem] leading-none font-light tracking-[-0.01em]">{SITE.wordmark}</span>
      <span class="eyebrow hidden pb-px opacity-60 sm:block">{SITE.wordmarkSub}</span>
    </a>

    <nav class="hidden items-center gap-10 lg:flex" aria-label="Primary">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="text-[0.75rem] font-medium tracking-[0.22em] uppercase transition-colors duration-300 hover:text-gold-light group-data-[scrolled=true]:hover:text-gold-dark"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <a
      href="/#contact"
      class="hidden items-center gap-3 border border-pearl/40 px-5 py-2.5 text-[0.6875rem] font-medium tracking-[0.22em] uppercase transition-colors duration-500 hover:border-gold-light hover:text-gold-light group-data-[scrolled=true]:border-ink/30 group-data-[scrolled=true]:hover:border-gold-dark group-data-[scrolled=true]:hover:text-gold-dark lg:inline-flex"
    >
      Request Private Service
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="group/toggle relative flex h-11 w-11 items-center justify-center lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <span class="relative block h-3 w-6">
        <span
          class="absolute top-0 left-0 block h-px w-6 bg-current transition-transform duration-400 group-aria-expanded/toggle:translate-y-[5.5px] group-aria-expanded/toggle:rotate-45"
        ></span>
        <span
          class="absolute bottom-0 left-0 block h-px w-6 bg-current transition-transform duration-400 group-aria-expanded/toggle:-translate-y-[5.5px] group-aria-expanded/toggle:-rotate-45"
        ></span>
      </span>
    </button>
  </div>
</header>

<!-- Full-screen mobile navigation -->
<div id="mobile-menu" hidden class="fixed inset-0 z-40 flex flex-col bg-navy-deep text-pearl lg:hidden">
  <nav class="mt-28 flex flex-1 flex-col gap-2 px-8" aria-label="Mobile">
    {
      NAV_LINKS.map((link, i) => (
        <a
          href={link.href}
          class="menu-link border-b border-pearl/10 py-4 font-serif text-4xl font-light tracking-[-0.01em] transition-colors duration-300 hover:text-gold-light"
          style={`--i: ${i}`}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
  <div class="menu-link px-8 pb-12" style={`--i: ${NAV_LINKS.length}`}>
    <p class="eyebrow mb-4 text-pearl/50">Direct correspondence</p>
    <a href={`mailto:${SITE.email}`} class="font-serif text-lg italic text-gold-light underline-offset-4 hover:underline">
      {SITE.email}
    </a>
  </div>
</div>

<style>
  /* Quiet staggered entrance for the mobile menu — CSS-only, no layout thrash. */
  #mobile-menu:not([hidden]) {
    animation: menu-fade 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  #mobile-menu:not([hidden]) .menu-link {
    animation: menu-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(0.08s + var(--i) * 0.06s);
  }
  @keyframes menu-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes menu-rise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    #mobile-menu:not([hidden]),
    #mobile-menu:not([hidden]) .menu-link {
      animation: none;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;

  const setMenu = (open: boolean) => {
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    header.dataset.menuOpen = String(open);
    document.documentElement.classList.toggle('overflow-hidden', open);
  };

  toggle.addEventListener('click', () => setMenu(menu.hidden));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) setMenu(false);
  });

  const onScroll = () => {
    header.dataset.scrolled = String(window.scrollY > 32);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
