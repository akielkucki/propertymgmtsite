---
/** Section masthead: tracked numeral with a trailing rule over a display
 *  headline — the same two-part structure the hero uses. */
interface Props {
  number: string;
  tone?: 'light' | 'dark';
  class?: string;
}

const { number, tone = 'light', class: className = '' } = Astro.props;
const dark = tone === 'dark';
---

<div class={className} data-reveal>
  <p class={`eyebrow eyebrow-rule mb-6 ${dark ? 'text-pearl/60' : 'text-ink/50'}`}>{number}</p>
  <h2 class={`display max-w-3xl text-[clamp(2.125rem,4.4vw,3.75rem)] ${dark ? 'text-pearl' : 'text-ink'}`}>
    <slot />
  </h2>
</div>
