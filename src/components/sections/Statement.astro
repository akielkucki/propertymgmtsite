---
import { Image } from 'astro:assets';
import Button from '../Button.astro';
import surfImage from '../../assets/surf.jpg';
---

<section class="grain relative overflow-hidden bg-navy-deep py-32 text-pearl md:py-44 lg:py-56">
  <div class="absolute inset-0">
    <Image
      src={surfImage}
      alt="Mark Stephens surfing inside the barrel of a breaking wave in Hawaii"
      widths={[828, 960]}
      sizes="100vw"
      class="h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-navy-deep/90 via-navy-deep/60 to-navy-deep/25"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-navy-deep/70 to-transparent" aria-hidden="true"></div>
  </div>

  <figure class="relative z-10 mx-auto w-full max-w-[90rem] px-6 md:px-10 lg:px-16" data-reveal>
    <div class="max-w-4xl">
      <span class="mb-10 block h-px w-16 bg-gold" aria-hidden="true"></span>
      <p class="eyebrow mb-8 text-gold-light">From the waters of Hawaii to the hills of New Hampshire</p>
      <blockquote class="font-serif text-[clamp(1.75rem,3.6vw,3rem)] font-light leading-[1.25] tracking-[-0.01em]">
        Surfing taught me <em class="italic text-gold-light">patience, balance, and respect</em> for forces larger
        than myself. In many ways, those same lessons guide how I care for the places and properties entrusted
        to me today.
      </blockquote>
      <figcaption class="eyebrow mt-10 text-pearl/50">Mark Stephens</figcaption>
      <p class="mt-10 max-w-2xl text-[0.9375rem] leading-relaxed text-pearl/75">
        The waters of Hawaii shaped how I work; today that same care serves homes and estates across the Upper
        Valley of New Hampshire and Vermont.
      </p>
      <div class="mt-10">
        <Button href="#contact" variant="light">Request Private Service</Button>
      </div>
    </div>
  </figure>
</section>
